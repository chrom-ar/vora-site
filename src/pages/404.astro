---
import "@/styles/globals.css";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/icon.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icon.svg" sizes="any" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-icon.png" sizes="180x180" type="image/png" />
  </head>
  <body>
    <div style="min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px; padding: 0 24px; text-align: center; background: #050505; color: #a3a3a3; font-family: var(--mono)">
      <h1 style="font-family: var(--sans); font-style: italic; font-size: clamp(64px, 12vw, 144px); margin: 0; color: #ffffff">404</h1>
      <p style="color: #a3a3a3; letter-spacing: 0.22em; text-transform: uppercase; font-size: 10.5px">Surface not indexed</p>
      <a href="/" style="margin-top: 16px; padding: 10px 18px; border: 1px solid rgba(255,255,255,.18); color: #a3a3a3; font-size: 10.5px; letter-spacing: 0.22em; text-transform: uppercase; text-decoration: none">← Return to scanner</a>
    </div>
  </body>
</html>
