---
import type { Messages } from "@/i18n/messages";
import Cta from "./Cta.astro";

type Props = { t: Messages["hero"] };

const { t } = Astro.props;
const last = t.words.length - 1;
---
<section class="hero screen" aria-labelledby="hero-title">
  <div class="wrap hero-inner">
    <p class="status" data-reveal="words"><span class="mask-word"><span class="dot" aria-hidden="true"></span>{t.status}</span></p>
    <h1 id="hero-title" class="h1" data-reveal="words">
      {t.words.map((w, i) => (
        <span class="word"><span class={i === last ? "mask-word grad" : "mask-word"} data-glitch>{w}</span></span>
      ))}
    </h1>
    <p class="lede" data-reveal="words"><span class="mask-word">{t.lede}</span></p>
    <div class="cta-row" data-reveal="words">
      <div class="mask-word">
        <Cta cta={t.ctaPrimary} variant="primary" />
        <Cta cta={t.ctaGhost} variant="ghost" />
      </div>
    </div>
  </div>
</section>

<div class="hero-foot" data-enter>
  <div class="hf-inner">
    <div class="hf-col"><span class="hf-label">{t.telemetryLabel}</span><span id="coords" class="hf-value">0.00.0.00.00</span></div>
    <div class="hf-col hf-center"><span class="hf-label">{t.scrollLabel}</span><span class="hf-line" aria-hidden="true"></span></div>
  </div>
</div>
