---
import type { Messages } from "@/i18n/messages";
import Tokens from "./Tokens.astro";

type Props = { t: Messages["problem"] };

const { t } = Astro.props;
---
<section id="problem" class="problem">
  <div class="wrap">
    <div class="sec-eye">{t.eyebrow}</div>
    <h2 class="sec-h"><Tokens value={t.h} /></h2>
    <p class="sec-sub">{t.sub}</p>
    <div class="problem-grid">
      {t.cards.map(c => (
        <div class="problem-card">
          <div class="num">{c.num}</div>
          <h3>{c.h}</h3>
          <p>{c.p}</p>
          <div class="stat"><b>{c.stat.b}</b> {c.stat.rest}</div>
        </div>
      ))}
    </div>
  </div>
</section>
