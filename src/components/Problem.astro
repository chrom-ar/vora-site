---
import type { Messages } from "@/i18n/messages";
import Signals from "./Signals.astro";

type Props = { t: Messages["problem"] };

const { t } = Astro.props;
---
<section id="problem" class="sec screen why" aria-labelledby="problem-title">
  <div class="wrap">
    <div class="why-grid">
      <div>
        <p class="eyebrow" data-reveal="words"><span class="mask-word">{t.eyebrow}</span></p>
        <h2 id="problem-title" class="h2 big" data-reveal="words"><span class="mask-word">{t.h}</span></h2>
      </div>
      <ul class="lines">
        {t.lines.map(l => (
          <li data-reveal="up"><strong>{l.b}</strong>{l.rest}</li>
        ))}
      </ul>
    </div>
    <Signals stats={t.stats} src={t.statSrc} aria={t.signalsAria} />
  </div>
</section>
