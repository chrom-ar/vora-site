---
import type { Messages } from "@/i18n/messages";
import PrMock from "./PrMock.astro";

type Props = { t: Messages["how"] };

const { t } = Astro.props;
---
<section id="how" class="sec screen how" aria-labelledby="how-title">
  <div class="wrap">
    <p class="eyebrow" data-reveal="words"><span class="mask-word">{t.eyebrow}</span></p>
    <h2 id="how-title" class="h2" data-reveal="words"><span class="mask-word">{t.h}</span></h2>
    <ol class="steps">
      {t.steps.map(s => (
        <li class="step" data-reveal="up"><span class="key">{s.key}</span><h3>{s.h}</h3><p>{s.p}</p></li>
      ))}
    </ol>
    <PrMock t={t.mock} />
  </div>
</section>
