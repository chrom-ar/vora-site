---
import type { Messages } from "@/i18n/messages";

type Props = { t: Messages["footer"] };

const { t } = Astro.props;
---
<footer class="foot">
  <div class="wrap foot-inner">
    <p class="foot-line">{t.line}</p>
    <nav class="foot-links" aria-label={t.navAria}>
      <a href={`mailto:${t.contact}`}>{t.contact}</a>
    </nav>
  </div>
</footer>
