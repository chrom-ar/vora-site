---
import type { Messages } from "@/i18n/messages";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import Problem from "./Problem.astro";
import HowItWorks from "./HowItWorks.astro";
import Trust from "./Trust.astro";
import Footer from "./Footer.astro";

type Props = { messages: Messages };

const { messages } = Astro.props;
---
<Header t={messages.header} />
<main id="main">
  <Hero t={messages.hero} />
  <Problem t={messages.problem} />
  <HowItWorks t={messages.how} />
  <Trust t={messages.trust} />
</main>
<Footer t={messages.footer} />
