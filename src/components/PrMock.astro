---
import type { PrMockMessages } from "@/i18n/messages";

type Props = { t: PrMockMessages };

const { t } = Astro.props;
---
<figure class="pr-mock" data-reveal="up">
  <figcaption class="sr-only">{t.caption}</figcaption>
  <div class="chrome" aria-hidden="true"><span class="dots"><i></i><i></i><i></i></span><span class="url">{t.chromeUrl}</span><span class="state">{t.chromeState}</span></div>
  <div class="pr-body">
    <div class="pr-meta" lang="en"><span class="pill">{t.pill}</span><p class="pr-title"><strong>{t.titleStrong}</strong> <small>{t.titleSmall}</small></p><span class="n">{t.n}</span></div>
    <div class="filebar"><span class="file" lang="en">{t.file}</span><span class="delta">{t.delta}</span><span class="ai">{t.ai}</span></div>
    <div class="diff" lang="en" role="img" aria-label={t.diffAria}>
      {t.codeLines.map(l => (
        <div class="line add"><span class="ln">{l.ln}</span><span class="sign">+</span><span class="code">{l.code}</span></div>
      ))}
    </div>
    <div class="review">
      <div class="rh"><span class="av" aria-hidden="true">V</span><span class="who"><b>{t.reviewer}</b> {t.reviewLine}</span></div>
      <div class="tags"><span class="sev">{t.sev}</span><span class="tag">{t.tag}</span></div>
      <p>{t.review.map(p => ("code" in p ? <code>{p.code}</code> : p.text))}</p>
    </div>
  </div>
</figure>
